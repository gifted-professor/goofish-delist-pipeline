  "statePolicy": {
    "loading": "Wait for an allowed anchor or empty state; do not click through loading.",
    "empty": "Record empty-state type only; do not create data for coverage.",
    "login": "Stop for user login; do not capture login material.",
    "noPermission": "Record gate state; do not bypass or switch identity.",
    "qrOrAppBridge": "Record bridge type only; do not save QR content or continue externally.",
    "confirmDialog": "Do not click confirm; summarize consequence and wait for user approval.",
    "highRiskBusinessState": "Read labels only; no state-changing action."
  },
  "summaryTemplate": {
    "page": "<route/hash>",
    "family": "<family>",
    "layer": "<M0-M6>",
    "evidence": "<evidence>",
    "state": "<normal/loading/empty/login/noPermission/dialog/highRisk>",
    "anchors": [
      "<visible structural anchors only>"
    ],
    "readable": [
      "fieldNames",
      "tabNames",
      "tableHeaders",
      "buttonNames",
      "statusCategory"
    ],
    "stopPoints": [
      "<stop points from manifest and family policy>"
    ],
    "privacy": "No real account, order, address, chat, item identity, amount, business metric, image URL, QR content, or login material recorded."
  }
}
