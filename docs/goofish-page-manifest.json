    "goofish-task-workflow-runbook.md",
    "goofish-evidence-coverage.md"
  ],
  "globalRules": [
    "Prefer visible page state over direct API calls.",
    "Do not invent real order, payment, refund, shipment, authentication, or seller-operation states for coverage.",
    "Deep parameter routes require user-provided context and remain read-only unless separately confirmed.",
    "Any submit, send, pay, refund, shipment, export, upload, download, permission, authentication, blacklist, proof, dispute, or publish action is gated.",
    "Outputs may include route shape, tab names, field names, table headers, status categories, risk levels, and stop points only."
  ],
