{
  "schema": "goofish-page-manifest/v1",
  "date": "2026-06-22",
  "purpose": "Machine-readable, privacy-safe inventory of observed or statically identified Goofish/Xianyu PC pages.",
  "privacy": {
    "storesRealAccountData": false,
    "storesRealOrderData": false,
    "storesRealAddressData": false,
    "storesRealChatData": false,
    "storesRealItemData": false,
    "storesLoginMaterial": false
  },
  "riskScales": {
    "layer": {
      "M0": "public discovery",
      "M1": "logged-in buyer read-only",
      "M2": "draft/input",
      "M3": "trade/funds",
      "M4": "seller operations",
      "M5": "identity/gate",
      "M6": "container/internal"
    },
    "readiness": {
      "R0": "public read-ready",
      "R1": "logged-in read-ready",
      "R2": "draft-assist ready",
      "R3": "confirmation-gated",
      "R4": "boundary read-only",
      "R5": "shell/container ready"
    },
    "action": {
      "G0": "public read",
      "G1": "logged-in read",
      "G2": "draft assist",
      "G3": "explicit confirmation required",
      "G4": "do not proactively trigger"
    }
  },
  "sourceDocuments": [
    "goofish-master-index.md",
    "goofish-page-map.md",
    "goofish-page-readiness-matrix.md",
    "goofish-site-taxonomy.md",
